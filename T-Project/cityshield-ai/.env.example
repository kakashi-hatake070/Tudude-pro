# ============================================
# CityShield AI — Environment Configuration
# ============================================

# ----- Frontend -----
VITE_API_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_SOCKET_URL=http://localhost:5000
VITE_MAPLIBRE_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
VITE_OSRM_URL=https://router.project-osrm.org

# ----- Backend (Node.js) -----
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/cityshield
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ----- AI Service (Python) -----
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
MODEL_PATH=./models/weights/

# ----- Cloudinary (Media Storage) -----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ----- External APIs -----
# IMD Weather API (if available)
IMD_API_URL=
IMD_API_KEY=
# OpenWeatherMap fallback
OPENWEATHER_API_KEY=

# ----- CORS -----
CORS_ORIGIN=http://localhost:5173

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
